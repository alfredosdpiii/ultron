{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@ultron/chord": ["../chord/dist/index.d.ts"],
			"@ultron/chord/bundler": ["../chord/dist/bundler.d.ts"],
			"@ultron/chord/node": ["../chord/dist/node.d.ts"],
			"@ultron/agent-core": ["../agent/dist/index.d.ts"],
			"@ultron/agent-core/*": ["../agent/dist/*.d.ts"],
			"@ultron/ai": ["../ai/dist/index.d.ts"],
			"@ultron/ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@ultron/tui": ["../tui/dist/index.d.ts"],
			"@ultron/tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist", "src/client"]
}
