{
	"$comment": "Secret detection rules shared by the RLM output masker (secrets.ts), the Python runtime (secret_patterns.py) and scripts/secret-scan.mjs. Regexes must behave the same in JavaScript and Python re (no named groups, no inline flags; use 'flags'). Example strings are split into parts so this file never contains a whole match; tests join them.",
	"version": 1,
	"safeSpans": [
		{
			"id": "python_env_index",
			"regex": "os\\.environ\\s*\\[\\s*[\"'][A-Za-z0-9_]+[\"']\\s*\\]"
		},
		{
			"id": "python_env_get",
			"regex": "(?:os\\.environ\\.get|os\\.getenv|getenv)\\(\\s*[\"'][A-Za-z0-9_]+[\"']"
		},
		{
			"id": "node_env",
			"regex": "process\\.env(?:\\.[A-Za-z_][A-Za-z0-9_]*|\\[\\s*[\"'][A-Za-z0-9_]+[\"']\\s*\\])"
		},
		{
			"id": "braced_var",
			"regex": "\\$\\{[A-Za-z_][A-Za-z0-9_.]*\\}"
		},
		{
			"id": "shell_var",
			"regex": "\\$[A-Za-z_][A-Za-z0-9_]*"
		},
		{
			"id": "template_var",
			"regex": "\\{\\{\\s*[A-Za-z0-9_.-]+\\s*\\}\\}"
		},
		{
			"id": "angle_placeholder",
			"regex": "<[A-Za-z][A-Za-z _.-]{0,40}>"
		},
		{
			"id": "redaction_marker",
			"regex": "\\[(?:REDACTED|MASKED|PLACEHOLDER)(?::[A-Za-z0-9_]+)?\\]"
		}
	],
	"testValue": {
		"description": "a value that is obviously not a real credential",
		"regex": "example|placeholder|dummy|changeme|redacted|your[_-]|x{4,}|X{4,}|\\*{3,}|\\.{3,}|^(.)\\1*$|^(?:password|passw0rd|secret|pass|test|admin|root)$",
		"flags": "i"
	},
	"rules": [
		{
			"id": "private_key",
			"description": "PEM private key block (RSA, EC, DSA, OPENSSH, PGP, PKCS#8, encrypted)",
			"regex": "-----BEGIN ((?:[A-Z0-9]+ )*)PRIVATE KEY((?: BLOCK)?)-----(?:[\\s\\S]{16,}?-----END \\1PRIVATE KEY\\2-----|(?:\\r?\\n|\\\\n)[A-Za-z0-9+/=]{40,}(?:(?:\\r?\\n|\\\\n)[A-Za-z0-9+/=]+)*)",
			"keywords": [
				"PRIVATE KEY"
			],
			"examples": {
				"flag": [
					[
						"-----BEGIN RSA PRIV",
						"ATE KEY-----\n",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V2w3X4y5Z6+/FAKE0",
						"\n",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R",
						"\n-----END RSA PRIV",
						"ATE KEY-----"
					],
					[
						"-----BEGIN OPENSSH PRIV",
						"ATE KEY-----\n",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V2w3X4y5Z6+/FAKE0a1B2c3",
						"\n"
					],
					[
						"{\"private_key\": \"-----BEGIN PRIV",
						"ATE KEY-----\\n",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V2w3X4y5Z6+/FAKE0",
						"\\n-----END PRIV",
						"ATE KEY-----\\n\"}"
					]
				],
				"pass": [
					[
						"-----BEGIN PUBLIC KEY-----\n",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V2w3X4y5Z6+/FAKE0",
						"\n-----END PUBLIC KEY-----"
					],
					[
						"if line.startswith(\"-----BEGIN PRIV",
						"ATE KEY-----\"):"
					]
				]
			}
		},
		{
			"id": "anthropic_key",
			"description": "Anthropic API key",
			"regex": "\\bsk-ant-[A-Za-z0-9_-]{32,}",
			"keywords": [
				"sk-ant-"
			],
			"examples": {
				"flag": [
					[
						"key = 'sk-a",
						"nt-api03-",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V",
						"'"
					]
				],
				"pass": [
					[
						"sk-a",
						"nt-short"
					],
					[
						"sk-a",
						"nt-api03-",
						"EXAMPLE",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R"
					]
				]
			}
		},
		{
			"id": "openai_key",
			"description": "OpenAI-style API key (sk-, sk-proj-, sk-svcacct-, sk-admin-)",
			"regex": "\\bsk-(?!ant-)(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{32,}",
			"keywords": [
				"sk-"
			],
			"examples": {
				"flag": [
					[
						"OPENAI=s",
						"k-proj-",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V"
					],
					[
						"client = OpenAI(api_key=\"s",
						"k-",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R",
						"\")"
					],
					[
						"key = os.environ.get(\"OPENAI_API_KEY\", \"s",
						"k-",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R",
						"\")"
					]
				],
				"pass": [
					[
						"task-",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R"
					],
					[
						"s",
						"k-",
						"your-key-here"
					]
				]
			}
		},
		{
			"id": "google_api_key",
			"description": "Google API key",
			"regex": "\\bAIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])",
			"keywords": [
				"AIza"
			],
			"examples": {
				"flag": [
					[
						"AI",
						"za",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5"
					]
				],
				"pass": [
					[
						"AI",
						"za",
						"FAKE0a1B2c3D4e5F6g7H"
					]
				]
			}
		},
		{
			"id": "github_token",
			"description": "GitHub token (ghp_, gho_, ghu_, ghs_, ghr_)",
			"regex": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b",
			"keywords": [
				"ghp_",
				"gho_",
				"ghu_",
				"ghs_",
				"ghr_"
			],
			"examples": {
				"flag": [
					[
						"g",
						"hp_",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P"
					],
					[
						"https://x-access-token:g",
						"hs_",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P",
						"@github.com/o/r.git"
					]
				],
				"pass": [
					[
						"g",
						"hp_",
						"FAKE0a1B2c3D"
					],
					[
						"ghx_",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P"
					]
				]
			}
		},
		{
			"id": "github_pat",
			"description": "GitHub fine-grained personal access token",
			"regex": "\\bgithub_pat_[A-Za-z0-9_]{50,}",
			"keywords": [
				"github_pat_"
			],
			"examples": {
				"flag": [
					[
						"github",
						"_pat_",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V2w3X4y5Z6FAKE0a1B2c3D4e5F6g7H8i9J0"
					]
				],
				"pass": [
					[
						"github",
						"_pat_",
						"FAKE0a1B2c"
					]
				]
			}
		},
		{
			"id": "slack_token",
			"description": "Slack token (xoxa-, xoxb-, xoxp-, xoxr-)",
			"regex": "\\bxox[abpr]-[A-Za-z0-9-]{10,}",
			"keywords": [
				"xox"
			],
			"examples": {
				"flag": [
					[
						"xo",
						"xb-",
						"1234567890-",
						"FAKE0a1B2c3D4e5F6g7H8i9J"
					]
				],
				"pass": [
					[
						"xo",
						"xz-",
						"FAKE0a1B2c3D4e5F6g7H8i9J"
					],
					[
						"xo",
						"xb-short"
					]
				]
			}
		},
		{
			"id": "aws_access_key_id",
			"description": "AWS access key id",
			"regex": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b",
			"keywords": [
				"AKIA",
				"ASIA"
			],
			"examples": {
				"flag": [
					[
						"AK",
						"IA",
						"FAKE0A1B2C3D4E5F"
					]
				],
				"pass": [
					[
						"AK",
						"IA",
						"SHORT"
					],
					[
						"AK",
						"IA",
						"FAKE0A1B2C3D4E5F6G7H"
					]
				]
			}
		},
		{
			"id": "aws_secret_key",
			"description": "AWS secret access key assignment",
			"regex": "\\baws_?secret_?(?:access_?)?key[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9/+]{40})(?![A-Za-z0-9/+=])",
			"flags": "i",
			"group": 1,
			"keywords": [
				"aws"
			],
			"examples": {
				"flag": [
					[
						"aws_secret_",
						"access_key = ",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R"
					],
					[
						"AWS_SECRET_",
						"ACCESS_KEY: \"",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R",
						"\""
					]
				],
				"pass": [
					[
						"aws_secret_access_key = os.environ[\"AWS_SECRET_ACCESS_KEY\"]"
					],
					[
						"aws_secret_access_key = ${AWS_SECRET}"
					]
				]
			}
		},
		{
			"id": "stripe_key",
			"description": "Stripe live secret or restricted key",
			"regex": "\\b[rs]k_live_[A-Za-z0-9]{20,}",
			"keywords": [
				"k_live_"
			],
			"examples": {
				"flag": [
					[
						"s",
						"k_live_",
						"FAKE0a1B2c3D4e5F6g7H8i9J"
					],
					[
						"stripe.api_key = os.getenv(\"STRIPE_KEY\", \"r",
						"k_live_",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m",
						"\")"
					]
				],
				"pass": [
					[
						"sk_test_",
						"FAKE0a1B2c3D4e5F6g7H8i9J"
					]
				]
			}
		},
		{
			"id": "npm_token",
			"description": "npm access token",
			"regex": "\\bnpm_[A-Za-z0-9]{36}\\b",
			"keywords": [
				"npm_"
			],
			"examples": {
				"flag": [
					[
						"//registry.npmjs.org/:_authToken=n",
						"pm_",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P"
					]
				],
				"pass": [
					[
						"npm_config_cache_directory_for_the_build"
					]
				]
			}
		},
		{
			"id": "jwt",
			"description": "JSON Web Token",
			"regex": "\\beyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{16,}",
			"keywords": [
				"eyJ"
			],
			"examples": {
				"flag": [
					[
						"Authorization: Bearer ey",
						"JhbGciOiJIUzI1NiJ9.ey",
						"JzdWIiOiJGQUtFIn0.",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9"
					]
				],
				"pass": [
					[
						"eyJhbGciOiJIUzI1NiJ9 alone"
					]
				]
			}
		},
		{
			"id": "url_credentials",
			"description": "password inside a URL (scheme://user:password@host)",
			"regex": "\\b[A-Za-z][A-Za-z0-9+.-]{1,20}://[^\\s:/@\"'<>]{1,64}:([^\\s:/@\"'<>]{6,128})@[^\\s/\"'<>]{3,}",
			"group": 1,
			"keywords": [
				"://"
			],
			"examples": {
				"flag": [
					[
						"postgres://app:",
						"FAKE0a1B2c3D4e5F6g",
						"@db.internal:5432/app"
					]
				],
				"pass": [
					[
						"postgres://app:${DB_PASSWORD}@db.internal/app"
					],
					[
						"`https://bot:${config.token}@example.com/repo.git`"
					],
					[
						"postgres://user:password@localhost/app"
					],
					[
						"https://example.com/path@v2"
					]
				]
			}
		},
		{
			"id": "generic_secret",
			"description": "quoted high-entropy literal assigned to a name like api_key, secret, token or password",
			"regex": "\\b[A-Za-z0-9_.-]{0,40}?(?:api[_-]?key|secret|token|passw(?:or)?d|pwd|auth[_-]?key|access[_-]?key|private[_-]?key|credential)s?[A-Za-z0-9_.-]{0,40}[\"']?\\s*(?::=|=>|[:=])\\s*([\"'])([^\"'\\s,;(){}<>\\\\]{16,256})\\1",
			"flags": "i",
			"group": 2,
			"keywords": [
				"key",
				"secret",
				"token",
				"pass",
				"pwd",
				"credential"
			],
			"minEntropy": 3,
			"requireLetterAndDigit": true,
			"rejectValue": "^(?:https?://|\\.{0,2}/|~/)|\\$\\{|\\{\\{|token|secret|passw|api[_-]?key|^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
			"rejectValueFlags": "i",
			"examples": {
				"flag": [
					[
						"api_key = \"",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N",
						"\""
					],
					[
						"\"client_secret\": \"",
						"FAKE0a1B2c3D4e5F6g7H8i9J",
						"\""
					],
					[
						"DB_PASSWORD => '",
						"FAKE0a1B2c3D4e5F6g7H",
						"'"
					]
				],
				"pass": [
					[
						"api_key = os.environ[\"API_KEY\"]"
					],
					[
						"token = \"${GITHUB_TOKEN}\""
					],
					[
						"password = \"<your password>\""
					],
					[
						"secret = \"[REDACTED]\""
					],
					[
						"api_key = \"xxxxxxxxxxxxxxxxxxxx\""
					],
					[
						"max_tokens = \"short\""
					],
					[
						"token_path = \"/var/run/secrets/kubernetes.io/token\""
					],
					[
						"password = \"correcthorsebatterystaple\""
					],
					[
						"X_AWS_METADATA_TOKEN = \"x-aws-ec2-metadata-token-ttl-seconds\""
					],
					[
						"\"qwen-token-plan.json\": \"1bb24ea68feaec83612940e7413bf953d1664a86a521c90750f4c93dd572d8ae\""
					],
					[
						"api_key = `",
						"${prefix}",
						"-",
						"${suffix}0123456789",
						"`"
					]
				]
			}
		},
		{
			"id": "env_secret",
			"description": "unquoted high-entropy value for an upper-case KEY/SECRET/TOKEN/PASSWORD variable (.env files, env output)",
			"regex": "^[ \\t]*(?:export[ \\t]+)?[A-Z0-9_]*(?:API_KEY|SECRET|TOKEN|PASSWORD|PASSWD|ACCESS_KEY|PRIVATE_KEY|CREDENTIALS?)[A-Z0-9_]*[ \\t]*=[ \\t]*([^\\s\"'`#$]{16,256})",
			"flags": "m",
			"group": 1,
			"keywords": [
				"KEY",
				"SECRET",
				"TOKEN",
				"PASSW",
				"CREDENTIAL"
			],
			"minEntropy": 3,
			"requireLetterAndDigit": true,
			"rejectValue": "^(?:https?://|\\.{0,2}/|~/)",
			"examples": {
				"flag": [
					[
						"DATABASE_PASSWORD=",
						"FAKE0a1B2c3D4e5F6g7H"
					],
					[
						"export SERVICE_API_KEY=",
						"FAKE0a1B2c3D4e5F6g7H8i9J0k1L2m3N"
					]
				],
				"pass": [
					[
						"SERVICE_API_KEY=$SERVICE_API_KEY"
					],
					[
						"TOKEN_FILE=/etc/app/token.txt"
					],
					[
						"API_KEY="
					]
				]
			}
		},
		{
			"id": "home_path",
			"description": "absolute home-directory path naming a real user (/home/<name>/, /Users/<name>/); generic and container user names are allowed",
			"regex": "(?:/home|/Users)/([A-Za-z0-9._-]+)/",
			"group": 1,
			"scopes": [
				"scan"
			],
			"keywords": [
				"/home/",
				"/Users/"
			],
			"allowValue": "^(?:user|username|runner|me|you|name|someone|somebody|alice|bob|carol|example|foo|bar|baz|test|tester|dev|ubuntu|node|root|hindsight)$",
			"allowValueFlags": "i",
			"examples": {
				"flag": [
					[
						"cd /ho",
						"me/jdoe-fake/src"
					],
					[
						"/Us",
						"ers/fakeperson/Library"
					]
				],
				"pass": [
					[
						"/home/user/project"
					],
					[
						"/Users/example/project"
					],
					[
						"/var/home"
					],
					[
						"$HOME/project"
					]
				]
			}
		}
	]
}
