{
 "extensions": [
  {
   "dir": "agent/extensions/greet",
   "commands": [
    {
     "name": "greet",
     "description": "Say hello"
    },
    {
     "name": "bare"
    }
   ]
  },
  {
   "dir": "agent/extensions/zeta",
   "commands": [
    {
     "name": "greet",
     "description": "Another greet"
    }
   ]
  },
  {
   "dir": "listed",
   "commands": [
    {
     "name": "listed-cmd",
     "description": "Listed in settings"
    }
   ]
  },
  {
   "dir": "cwd/.pi/extensions/proj",
   "commands": [
    {
     "name": "proj-cmd",
     "description": "Project command"
    }
   ]
  },
  {
   "dir": "cwd/.pi/local/proj-entry",
   "commands": [
    {
     "name": "proj-entry",
     "description": "Listed in project settings"
    }
   ]
  }
 ],
 "settings": {
  "user": [
   "<TMP>/listed",
   "extensions/zeta"
  ],
  "project": [
   "local/proj-entry"
  ]
 },
 "commands": [
  {
   "name": "proj-entry",
   "description": "Listed in project settings",
   "source": "extension",
   "sourceInfo": {
    "path": "<TMP>/cwd/.pi/local/proj-entry/index.ts",
    "source": "local",
    "scope": "project",
    "origin": "top-level"
   }
  },
  {
   "name": "proj-cmd",
   "description": "Project command",
   "source": "extension",
   "sourceInfo": {
    "path": "<TMP>/cwd/.pi/extensions/proj/index.ts",
    "source": "auto",
    "scope": "project",
    "origin": "top-level",
    "baseDir": "<TMP>/cwd/.pi"
   }
  },
  {
   "name": "listed-cmd",
   "description": "Listed in settings",
   "source": "extension",
   "sourceInfo": {
    "path": "<TMP>/listed/index.ts",
    "source": "local",
    "scope": "user",
    "origin": "top-level"
   }
  },
  {
   "name": "greet:1",
   "description": "Another greet",
   "source": "extension",
   "sourceInfo": {
    "path": "<TMP>/agent/extensions/zeta/index.ts",
    "source": "local",
    "scope": "user",
    "origin": "top-level"
   }
  },
  {
   "name": "greet:2",
   "description": "Say hello",
   "source": "extension",
   "sourceInfo": {
    "path": "<TMP>/agent/extensions/greet/index.ts",
    "source": "auto",
    "scope": "user",
    "origin": "top-level",
    "baseDir": "<TMP>/agent"
   }
  },
  {
   "name": "bare",
   "source": "extension",
   "sourceInfo": {
    "path": "<TMP>/agent/extensions/greet/index.ts",
    "source": "auto",
    "scope": "user",
    "origin": "top-level",
    "baseDir": "<TMP>/agent"
   }
  },
  {
   "name": "mcp",
   "description": "MCP servers: status, connect or disconnect, sign in, enable or disable",
   "source": "extension",
   "sourceInfo": {
    "path": "<inline:mcp>",
    "source": "inline",
    "scope": "temporary",
    "origin": "top-level"
   }
  }
 ]
}
