   "result": {
    "value": {
     "output": "plain\n",
     "exitCode": 0
    }
   },
   "argv": "[-c]\n[echo plain]\n"
  },
  {
   "prefix": null,
   "command": "echo none",
   "result": {
    "value": {
     "output": "none\n",
     "exitCode": 0
    }
   },
   "argv": "[-c]\n[echo none]\n"
  }
 ]
