{
 "configs": [
  {
   "custom": "<dir>/fake-shell",
   "result": {
    "value": {
     "shell": "<dir>/fake-shell",
     "args": [
      "-c"
     ]
    }
   }
  },
  {
   "custom": "<dir>/missing-shell",
   "result": {
