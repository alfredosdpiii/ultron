# Paths excused by scripts/secret-scan.mjs (npm run scan:secrets, CI, releases).
# One glob per line (** any directories, * within a directory), optionally followed by the rule ids it excuses,
# comma-separated; without ids every rule is excused. Globs match paths relative to the scanned root, so start with
# **/ when an entry must also match inside a release tarball (package/...). List only files that must hold fake
# credentials or example paths; build fakes from parts at run time where you can, so no entry is needed.

# Recorded upstream sessions, crash logs and a demo script with the original authors' paths.
packages/coding-agent/test/fixtures/*.jsonl home_path
packages/coding-agent/test/crash-log.test.ts home_path
**/examples/extensions/overlay-qa-tests.ts home_path

# Sentinel values that tests check are refused.
packages/coding-agent/test/ultron-a53-code-skills.test.ts generic_secret
packages/coding-agent/test/ultron-code-skill-signals.test.ts generic_secret,aws_access_key_id
